{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fat-loss-websites",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "fat-loss-websites"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "growmedico-test-db",
      "database_id": "ad4ef46c-e445-40bb-845a-1ae10fbc8240"
    }
  ]
}